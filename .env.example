# Copy to .env and adjust. Every variable is optional; the defaults below are used when unset.
# This app runs entirely in the browser and needs no API keys or other secrets.

# Folder under public/ that holds profiles.json and the lab files it lists.
# Use "local-data" for your own records; that folder is git-ignored.
VITE_DATA_DIR=data

# Public base path of the production build. "./" works from any folder or static host.
# For GitHub Pages project sites use "/<repository-name>/".
VITE_BASE_PATH=./

# Ports for `npm run dev` and `npm run preview`.
PORT=5173
PREVIEW_PORT=4173
